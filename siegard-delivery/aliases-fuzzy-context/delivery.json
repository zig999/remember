{
  "contract_version": "siegard-delivery/2",
  "nodes": [
    {
      "id": "implementation/alias-admission/admit-aliases-from-source",
      "kind": "implementation",
      "file": "implementation/alias-admission/admit-aliases-from-source.md",
      "title": "Alias admission against the source in the node-proposal service",
      "summary": "A node proposal now records only the aliases whose normalized form occurs in the normalized content of its run's raw information, exempts directed runs, and names each refused alias with ALIAS_NOT_IN_SOURCE in the service result.",
      "task": "task/alias-admission/admit-aliases-from-source"
    },
    {
      "id": "implementation/alias-admission/default-prompt-version-v5",
      "kind": "implementation",
      "file": "implementation/alias-admission/default-prompt-version-v5.md",
      "title": "Default prompt version moves to v5",
      "summary": "DEFAULT_PROMPT_VERSION is now bound to the v5 module's PROMPT_VERSION, so an ingest_document call that names no prompt version opens its run under v5.",
      "task": "task/alias-admission/default-prompt-version-v5"
    },
    {
      "id": "implementation/alias-admission/prompt-v5-asks-for-other-names",
      "kind": "implementation",
      "file": "implementation/alias-admission/prompt-v5-asks-for-other-names.md",
      "title": "Extraction prompt v5 asks for other names",
      "summary": "Registers a v5 extraction prompt module composed over v4 that adds an instruction to propose every other name the text gives each entity, and leaves v1 to v4 and the default version untouched.",
      "task": "task/alias-admission/prompt-v5-asks-for-other-names"
    },
    {
      "id": "implementation/approximate-node-search/approximate-node-match",
      "kind": "implementation",
      "file": "implementation/approximate-node-search/approximate-node-match.md",
      "title": "Approximate node match through word similarity",
      "summary": "The node layer of search gains a trigram route over node_alias.alias_norm, merged after the full-text route under one 200-candidate cap, so a misspelled name reaches its knowledge node and expands from it like any matched node.",
      "task": "task/approximate-node-search/approximate-node-match"
    },
    {
      "id": "implementation/approximate-node-search/rank-approximate-reach-last",
      "kind": "implementation",
      "file": "implementation/approximate-node-search/rank-approximate-reach-last.md",
      "title": "Rank approximate reach last",
      "summary": "The search service now sorts merged items by whether they were reached only through approximately matched nodes before it sorts by score, recording time and identifier.",
      "task": "task/approximate-node-search/rank-approximate-reach-last"
    },
    {
      "id": "implementation/approximate-node-search/search-item-shows-match",
      "kind": "implementation",
      "file": "implementation/approximate-node-search/search-item-shows-match.md",
      "title": "Search item shows how a node matched",
      "summary": "Each hop-0 knowledge node search item now carries match (exact or approximate), and an approximate one also carries the node's highest unweighted word similarity; link and fragment items carry neither, and computeFlags is unchanged.",
      "task": "task/approximate-node-search/search-item-shows-match"
    },
    {
      "id": "implementation/document-context/chunk-prompt-shows-context",
      "kind": "implementation",
      "file": "implementation/document-context/chunk-prompt-shows-context.md",
      "title": "Each chunk is shown the document context",
      "summary": "The v5 per-chunk user prompt now renders the run's document context (summary and each entity with its node type and names) between the source metadata and the previous-chunk tail, and the extraction orchestrator hands the context to every chunk of a run that holds one.",
      "task": "task/document-context/chunk-prompt-shows-context"
    },
    {
      "id": "implementation/document-context/context-model-setting",
      "kind": "implementation",
      "file": "implementation/document-context/context-model-setting.md",
      "title": "Context model setting threaded to every orchestrator entry point",
      "summary": "The environment now yields a context model (claude-haiku-4-5 when none is configured), and the REST run route, the MCP ingest toolset and the stdio server each hand it to the extraction orchestrator through its dependency type.",
      "task": "task/document-context/context-model-setting"
    },
    {
      "id": "implementation/document-context/failed-reading-continues",
      "kind": "implementation",
      "file": "implementation/document-context/failed-reading-continues.md",
      "title": "Failed preliminary reading continues",
      "summary": "A preliminary reading that fails is caught and logged, the run's document context status is recorded as failed with no document context stored, and the extraction goes on to read every chunk and complete.",
      "task": "task/document-context/failed-reading-continues"
    },
    {
      "id": "implementation/document-context/preliminary-reading",
      "kind": "implementation",
      "file": "implementation/document-context/preliminary-reading.md",
      "title": "Preliminary reading produces the document context",
      "summary": "Under prompt v5 or later, a multi-chunk extraction whose content is at most 100000 UTF-16 code units and whose run holds no document context makes one tool-less model reading before its first chunk, and records the resulting document context and the status produced in one transaction.",
      "task": "task/document-context/preliminary-reading"
    },
    {
      "id": "implementation/document-context/record-document-context",
      "kind": "implementation",
      "file": "implementation/document-context/record-document-context.md",
      "title": "Record the document context on the run",
      "summary": "The llm_run repository can now write a run's document context and its document context status separately, and every query that returns a run row reads both back, null when none was recorded. An entity in a document context must list at least one name.",
      "task": "task/document-context/record-document-context"
    },
    {
      "id": "implementation/document-context/retry-reuses-document-context",
      "kind": "implementation",
      "file": "implementation/document-context/retry-reuses-document-context.md",
      "title": "Retry reuses the document context",
      "summary": "A run that already holds a document context keeps it through retry and through the next extraction, which makes no preliminary reading and shows each chunk with that context. A run that holds none, including one whose status is failed, gets a reading.",
      "task": "task/document-context/retry-reuses-document-context"
    },
    {
      "id": "implementation/document-context/run-answers-show-document-context",
      "kind": "implementation",
      "file": "implementation/document-context/run-answers-show-document-context.md",
      "title": "Run answers show the document context",
      "summary": "The read-llm-run answers (REST and MCP) and the run-extraction answer now carry a run's document context status and its whole document context (summary, entities, model) when the run holds them, and omit each key when it does not.",
      "task": "task/document-context/run-answers-show-document-context"
    },
    {
      "id": "implementation/document-context/skip-preliminary-reading",
      "kind": "implementation",
      "file": "implementation/document-context/skip-preliminary-reading.md",
      "title": "Skip the preliminary reading and record why",
      "summary": "Under v5 and later, an extraction over a single-chunk raw information, or over a multi-chunk one whose content exceeds 100000 UTF-16 code units, makes no preliminary reading and records the document context status single-chunk or too-long, then reads its chunks as before, each shown the last 200 Unicode code points of the chunk before it.",
      "task": "task/document-context/skip-preliminary-reading"
    },
    {
      "id": "proof/alias-admission/admit-aliases-from-source",
      "kind": "proof",
      "file": "proof/alias-admission/admit-aliases-from-source.md",
      "title": "Proof for alias admission against the source in the node-proposal service",
      "summary": "Service-level tests, over an in-memory stand-in for the store, that a node proposal records only aliases the source holds (directed runs exempt), names each refused alias with ALIAS_NOT_IN_SOURCE, adds only aliases to a matched node, and lets an admitted alias resolve a later proposal; the four scenario nodes are now unproven and listed under untested, because only a real Postgres running the admission query and norm() can decide them.",
      "task": "task/alias-admission/admit-aliases-from-source"
    },
    {
      "id": "proof/alias-admission/default-prompt-version-v5",
      "kind": "proof",
      "file": "proof/alias-admission/default-prompt-version-v5.md",
      "title": "Proof that the default prompt version is v5",
      "summary": "A document ingestion that names no prompt version opens its run under the literal v5 and extracts under the v5 prompt module, run through real intake and extraction. An explicit version is still honored, and the v1 to v5 enumeration is decided by one test.",
      "task": "task/alias-admission/default-prompt-version-v5"
    },
    {
      "id": "proof/alias-admission/prompt-v5-asks-for-other-names",
      "kind": "proof",
      "file": "proof/alias-admission/prompt-v5-asks-for-other-names.md",
      "title": "Proof for extraction prompt v5 asking for other names",
      "summary": "Tests that v5 is a held prompt version whose request to the model asks for every other name of an entity, that every held version from v5 on does the same, that every held version from v4 on names the relative-date words, that v5 keeps each v4 instruction line whole, that an extraction under an unheld version fails without asking the model, and that v1 to v4 ask for no other names.",
      "task": "task/alias-admission/prompt-v5-asks-for-other-names"
    },
    {
      "id": "proof/approximate-node-search/approximate-node-match",
      "kind": "proof",
      "file": "proof/approximate-node-search/approximate-node-match.md",
      "title": "Proof for approximate node match through word similarity",
      "summary": "Unit tests over the search service, with a fake store standing in for PostgreSQL, prove that approximate hits become hop-0 node items, that a node matched both ways appears once with its exact score, that the node layer keeps at most 200 candidates across both routes, that the fragment and chunk layers gain no trigram route, and that links expand from an approximate match at 0.5 raised to the hop. The facts that only pg_trgm inside PostgreSQL decides (threshold, 5-character floor, normalization, strength) are listed as unproven, because the suite has no real database.",
      "task": "task/approximate-node-search/approximate-node-match"
    },
    {
      "id": "proof/approximate-node-search/rank-approximate-reach-last",
      "kind": "proof",
      "file": "proof/approximate-node-search/rank-approximate-reach-last.md",
      "title": "Proof for ranking approximate reach last",
      "summary": "Tests over the search service, with the store stood in for, prove that items reached only through approximately matched nodes rank last and that each group orders by score, recording time and identifier, with the order decided for the three underdetermined entries, and that inside the trailing group links of equal score order by recording time then identifier with an equal-score knowledge node last.",
      "task": "task/approximate-node-search/rank-approximate-reach-last"
    },
    {
      "id": "proof/approximate-node-search/search-item-shows-match",
      "kind": "proof",
      "file": "proof/approximate-node-search/search-item-shows-match.md",
      "title": "Proof that a hop-0 knowledge node search item shows how it matched",
      "summary": "Service-level and transport-level tests that exact and approximate hop-0 node items carry match and similarity as the specification states, that link and fragment items (including a fragment a chunk-layer match also supports) carry neither, and that flags stay free of match values.",
      "task": "task/approximate-node-search/search-item-shows-match"
    },
    {
      "id": "proof/document-context/chunk-prompt-shows-context",
      "kind": "proof",
      "file": "proof/document-context/chunk-prompt-shows-context.md",
      "title": "Proof that each chunk is shown the document context",
      "summary": "Seven tests in two spec files show that a run holding a document context reads its chunks one at a time in index order, each with the context, the source metadata and the 200-code-point tail, and that content and context are presented as data in a delimited block outside the instructions. They also show that a run holding none shows no context, that the João Silva scenario resolves and anchors as stated, and that a fragment is anchored to the chunk being read whatever chunks the model names.",
      "task": "task/document-context/chunk-prompt-shows-context"
    },
    {
      "id": "proof/document-context/context-model-setting",
      "kind": "proof",
      "file": "proof/document-context/context-model-setting.md",
      "title": "Proof for the context model setting threaded to every orchestrator entry point",
      "summary": "The env default and the configured context model are tested directly, and the REST route, the MCP toolset and the stdio server are each tested for handing the configured model to the orchestrator.",
      "task": "task/document-context/context-model-setting"
    },
    {
      "id": "proof/document-context/failed-reading-continues",
      "kind": "proof",
      "file": "proof/document-context/failed-reading-continues.md",
      "title": "Proof for the failed preliminary reading that continues",
      "summary": "Seven tests added to the existing preliminary-reading unit spec prove that a failed preliminary reading leaves the run completed, with every chunk read, status failed and no document context, whether the failure is a provider error, a timeout or an unparseable answer.",
      "task": "task/document-context/failed-reading-continues"
    },
    {
      "id": "proof/document-context/preliminary-reading",
      "kind": "proof",
      "file": "proof/document-context/preliminary-reading.md",
      "title": "Proof for the preliminary reading that produces the document context",
      "summary": "Nineteen behavior tests over a v5 three-chunk extraction prove that one tool-less reading is made first with the whole content under the configured context model, that the cut, filtered and labelled context and the status produced are recorded, and that every model call of the extraction, the reading included, is abandoned within five minutes and attempted at most three times, observed through the real SDK client over a stubbed fetch under fake timers.",
      "task": "task/document-context/preliminary-reading"
    },
    {
      "id": "proof/document-context/record-document-context",
      "kind": "proof",
      "file": "proof/document-context/record-document-context.md",
      "title": "Proof for recording the document context on an LLM run",
      "summary": "Tests that a run's document context and its status read back through findLlmRunById as recorded and null when none was recorded, that the status enumeration holds exactly four values, and that the context and entity schemas refuse an entity with no node type or names and a context with no summary or model.",
      "task": "task/document-context/record-document-context"
    },
    {
      "id": "proof/document-context/retry-reuses-document-context",
      "kind": "proof",
      "file": "proof/document-context/retry-reuses-document-context.md",
      "title": "Proof that a retried run reuses the document context it holds",
      "summary": "Seven tests chain the real retry and the real extraction over an in-memory run store, and show that retry keeps the held context and every status. They also show that a retried run holding a context makes no second reading, shows each chunk that context and keeps its status under v5 and under a later prompt version, and that a retried run holding none reads again.",
      "task": "task/document-context/retry-reuses-document-context"
    },
    {
      "id": "proof/document-context/run-answers-show-document-context",
      "kind": "proof",
      "file": "proof/document-context/run-answers-show-document-context.md",
      "title": "Proof for run answers showing the document context",
      "summary": "Proves that the read-llm-run answers over REST and MCP and the run-extraction answer carry a run's document context status and whole document context when the run holds them, and, over a stand-in store and model, that an extraction shows each chunk the document context it records.",
      "task": "task/document-context/run-answers-show-document-context"
    },
    {
      "id": "proof/document-context/skip-preliminary-reading",
      "kind": "proof",
      "file": "proof/document-context/skip-preliminary-reading.md",
      "title": "Proof for skipping the preliminary reading and recording why",
      "summary": "Tests that a run under v5 and later makes no preliminary reading for one chunk or for more than 100000 UTF-16 code units and records single-chunk or too-long, that failed and produced are recorded under v5, v6 and v10 alike, that every chunk is still read in order with its metadata and previous-chunk tail, and that v1 to v4 record nothing.",
      "task": "task/document-context/skip-preliminary-reading"
    },
    {
      "id": "review/aliases-fuzzy-context-2",
      "kind": "review",
      "file": "review/aliases-fuzzy-context-2.md",
      "title": "Review again of the aliases-fuzzy-context delivery",
      "summary": "The four passes over the 53 backend files the 11 tasks whose proofs were re-delivered after the first review name, with every finding they returned.",
      "ran": [
        "coverage",
        "conformance",
        "standard"
      ],
      "unproven": [
        "A node proposal resolved to an existing knowledge node does not add its proposed name to that node.",
        "A proposed alias that differs from the source text only in case, accents or inner whitespace is not refused as ALIAS_NOT_IN_SOURCE.",
        "A proposed alias that occurs in a chunk other than the one being read is not refused as ALIAS_NOT_IN_SOURCE.",
        "A search for \"petrobras\" over the knowledge nodes \"Petrobras\" and \"Petrobrás Distribuidora\", each with an accepted information fragment mentioning it, returns both knowledge nodes.",
        "In a search for \"petrobras\" over the knowledge nodes \"Petrobras\" and \"Petrobrás Distribuidora\", both returned knowledge node items carry the match exact.",
        "Outside a directed ingestion, a proposed alias whose normalized form does not occur in the normalized content of the raw information of the run is not recorded on the knowledge node.",
        "The read-llm-run answer over MCP carries the document context of a run that holds one.",
        "The read-llm-run answer over MCP carries the document context status of a run that holds one.",
        "The result of the node-proposal service names each alias it did not admit, with the reason ALIAS_NOT_IN_SOURCE.",
        "Within a directed ingestion, a proposed alias that no fragment text holds is not refused as ALIAS_NOT_IN_SOURCE."
      ],
      "findings": 125
    }
  ],
