classDiagram
    namespace ApplicationShellAggregate {
        class ApplicationShell {
            <<AggregateRoot>>
            +ShellHealth health
            +integer curationPending
            +string asOf
            +boolean paletteOpen
            +string address
            +string reason
            +openAddress()
            +togglePalette()
            +chooseAsOf()
            +showFailure()
        }
    }
    namespace ConversationMenuAggregate {
        class ConversationMenu {
            <<AggregateRoot>>
            +boolean includeArchived
            +string renameDraft
            +boolean deletePending
            +create()
            +select()
            +rename()
            +archive()
            +unarchive()
            +delete()
        }
    }
    namespace FailureRouterAggregate {
        class FailureRouter {
            <<AggregateRoot>>
            +FailureAction action
            +ToastTone tone
            +string message
            +routeFailure()
            +applyAction()
        }
    }
    namespace MessageBubbleAggregate {
        class MessageBubble {
            <<AggregateRoot>>
            +MessageRole role
            +boolean streaming
            +boolean errored
            +string stopNotice
            +showMessage()
        }
    }
    namespace OwnerSessionAggregate {
        class OwnerSession {
            <<AggregateRoot>>
            +string accessToken
            +string subject
            +integer expiresAt
            +string name
            +string email
            +setToken()
            +clear()
            +checkFreshness()
        }
    }
    namespace RequestHelperAggregate {
        class RequestHelper {
            <<AggregateRoot>>
            +string baseUrl
            +string failureCode
            +sendRequest()
            +refreshToken()
        }
    }
    namespace StateBadgeAggregate {
        class StateBadge {
            <<AggregateRoot>>
            +ConfidenceState state
            +boolean iconOnly
            +showState()
        }
    }
    class FailureAction {
        <<Enumeration>>
        REDIRECT
        TOAST_AND_NAVIGATE
        BOUNDARY
        SET_ERROR
        INLINE_EMPTY
        INLINE_GONE
        TOAST
        SILENT
    }
    class ShellHealth {
        <<Enumeration>>
        OK
        DOWN
        CHECKING
    }
    class ToastTone {
        <<Enumeration>>
        WARNING
        DANGER
    }
    class MessageRole {
        <<external: chat>>
    }
    class ConfidenceState {
        <<external: graph-explorer>>
    }
