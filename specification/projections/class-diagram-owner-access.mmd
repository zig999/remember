classDiagram
    namespace SignInAttemptAggregate {
        class SignInAttempt {
            <<AggregateRoot>>
            +SignInCredentials credentials
            +SignInFailureKind failureKind
            +SignInDestination destination
            +submitCredentials()
            +requestAccessToken()
            +classifyFailure()
            +resolveDestination()
        }
    }
    class SignInCredentials {
        <<ValueObject>>
        +string email
        +string password
    }
    class SignInDestination {
        <<ValueObject>>
        +string path
    }
    class SignInFailureKind {
        <<Enumeration>>
        CREDENTIAL
        NETWORK
        SESSION
        UNKNOWN
    }
