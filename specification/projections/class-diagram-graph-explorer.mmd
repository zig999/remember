classDiagram
    namespace GraphPaneAggregate {
        class GraphPane {
            <<AggregateRoot>>
            +GraphNodeView[] nodes
            +GraphLinkView[] links
            +string positions
            +string[] userPinned
            +string[] revealQueue
            +string[] revealed
            +GraphPaneStatus status
            +string errorMessage
            +boolean receivedDeltaThisTurn
            +GraphLayout layoutAlgorithm
            +integer layoutNonce
            +TurnEnd lastTurnEnd
            +GraphSnapshotVersion snapshotVersion
            +addDelta()
            +replaceDelta()
            +removeNodes()
            +moveNode()
            +reorganize()
            +chooseLayout()
            +settleTurn()
            +restoreView()
            +clear()
        }
    }
    namespace NodeDetailAggregate {
        class NodeDetail {
            <<AggregateRoot>>
            +string nodeId
            +string label
            +boolean curationOpen
            +NodeDetailFailure failure
            +OriginFailure originFailure
            +openDetail()
            +closeDetail()
            +openCuration()
        }
    }
    class ConfidenceState {
        <<Enumeration>>
        ACCEPTED
        UNCERTAIN
        LOW_CONFIDENCE
        DISPUTED
        SUPERSEDED
    }
    class GraphLinkView {
        <<ValueObject>>
        +string id
        +string source
        +string target
        +string label
        +string linkTypeLabel
        +boolean isTemporal
        +boolean inEffect
        +ConfidenceState state
    }
    class GraphNodeView {
        <<ValueObject>>
        +string id
        +string type
        +string label
        +ConfidenceState state
        +string subtitle
    }
    class GraphPaneStatus {
        <<Enumeration>>
        EMPTY
        LOADING
        REVEALING
        READY
        ERROR
    }
    class GraphSnapshotVersion {
        <<Enumeration>>
        1
        2
    }
    class NodeDetailFailure {
        <<Enumeration>>
        NOT_FOUND
        DELETED
        GENERIC
    }
    class OriginFailure {
        <<Enumeration>>
        NOT_FOUND
        DELETED
        GENERIC
        UNKNOWN
    }
    class TurnEnd {
        <<Enumeration>>
        DONE
        ERROR
    }
    class GraphLayout {
        <<external: chat>>
    }
