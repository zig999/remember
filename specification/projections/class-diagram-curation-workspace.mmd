classDiagram
    namespace CurationSessionAggregate {
        class CurationSession {
            <<AggregateRoot>>
            +SelectedItem selectedItem
            +boolean evidenceViewed
            +integer sessionResolved
            +integer lastSeenTotal
            +string[] checkedItemIds
            +PendingDecision pendingDecision
            +DecisionDraft draft
            +CorrectionDraft correction
            +selectItem()
            +decide()
            +undoDecision()
            +moveOn()
            +resetSession()
        }
    }
    class BatchKind {
        <<Enumeration>>
        ENTITY_MATCH
        DISPUTED
        UNCERTAIN
    }
    class CorrectionDraft {
        <<ValueObject>>
        +string value
        +string targetNodeId
        +date validFrom
        +date validTo
        +ValidFromBasis validFromBasis
        +string validFromFragmentId
        +string reason
    }
    class CurationShortcut {
        <<Enumeration>>
        NEXT
        PREVIOUS
        TOGGLE_CHECK
        EVIDENCE
        MERGE
        KEEP_SEPARATE
        CONFIRM
        REJECT
        UNDO
        TOGGLE_HELP
        SELECT_INDEX
    }
    class DecisionDraft {
        <<ValueObject>>
        +string candidateId
        +string sideId
        +string reason
    }
    class DispatchKind {
        <<Enumeration>>
        DESTRUCTIVE
        IMMEDIATE
    }
    class DisplayMode {
        <<Enumeration>>
        SUMMARY
        FULL_DIFF
    }
    class PendingDecision {
        <<ValueObject>>
        +string caption
        +DispatchKind dispatchKind
        +datetime deadline
    }
    class QueueTab {
        <<Enumeration>>
        ALL
        ENTITIES
        DISPUTES
    }
    class SelectedItem {
        <<ValueObject>>
        +ReviewQueueKind kind
        +string id
    }
    class ReviewQueueKind {
        <<external: knowledge-base>>
    }
    class ValidFromBasis {
        <<external: knowledge-base>>
    }
