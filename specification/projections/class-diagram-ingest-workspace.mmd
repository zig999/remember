classDiagram
    namespace IngestSessionAggregate {
        class IngestSession {
            <<AggregateRoot>>
            +string content
            +SourceType sourceType
            +IngestPhase phase
            +string llmRunId
            +string[] affectedNodeIds
            +RunSummary summary
            +IngestFailure failure
            +string validationMessage
            +submitIngest()
            +recordSource()
            +runExtraction()
            +pollRun()
            +retryRun()
            +assembleGraph()
            +resetSession()
        }
    }
    class IngestFailure {
        <<ValueObject>>
        +string code
        +string message
    }
    class IngestPhase {
        <<Enumeration>>
        IDLE
        READY
        SENDING
        NOOP
        EXTRACTING
        POLLING
        REVEALING
        COMPLETE
        ERROR
    }
    class RunSummary {
        <<external: knowledge-base>>
    }
    class SourceType {
        <<external: knowledge-base>>
    }
