classDiagram
    namespace ChatSessionAggregate {
        class ChatSession {
            <<AggregateRoot>>
            +string conversationId
            +string draft
            +ChatStatus chatStatus
            +string streamedText
            +ToolChip[] toolChips
            +string idempotencyKey
            +boolean isStreaming
            +SendOutcome lastOutcome
            +MessageListState historyState
            +selectConversation()
            +sendMessage()
            +stopTurn()
            +cancelTurn()
            +reactivateConversation()
        }
    }
    class ChatStatus {
        <<Enumeration>>
        IDLE
        THINKING
        STREAMING
        TOOL_RUNNING
        ERROR
    }
    class MessageListState {
        <<Enumeration>>
        LOADING
        ERROR
        STREAMING
        EMPTY
        SUCCESS
    }
    class SendOutcome {
        <<ValueObject>>
        +AssistantStopReason stopReason
        +string errorCode
        +string errorMessage
        +string idempotencyKey
    }
    class ToolChip {
        <<ValueObject>>
        +string tool
        +string argsSummary
        +ToolChipOutcome outcome
    }
    class ToolChipOutcome {
        <<Enumeration>>
        PENDING
        SUCCEEDED
        FAILED
    }
    class AssistantStopReason {
        <<external: chat>>
    }
