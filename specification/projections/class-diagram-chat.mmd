classDiagram
    namespace ConversationAggregate {
        class Conversation {
            <<AggregateRoot>>
            +string title
            +string rollingSummary
            +datetime archivedAt
            +datetime createdAt
            +datetime updatedAt
        }
        class GraphView {
            <<Entity>>
            +string snapshot
            +datetime updatedAt
        }
        class Message {
            <<Entity>>
            +MessageRole role
            +string content
            +string stopReason
            +string idempotencyKey
            +string model
            +integer tokensIn
            +integer tokensOut
            +integer latencyMs
        }
        class ToolCall {
            <<Entity>>
            +string toolName
            +string arguments
            +string result
            +boolean isError
            +string errorMessage
            +integer durationMs
        }
    }
    class MessageRole {
        <<Enumeration>>
        USER
        ASSISTANT
    }
    Conversation "1" *-- "0..*" Message
    Conversation "1" *-- "0..*" ToolCall
    Conversation "1" *-- "0..1" GraphView
    ToolCall "0..*" -- "0..1" Message
