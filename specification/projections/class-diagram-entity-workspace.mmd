classDiagram
    namespace EntityEditSessionAggregate {
        class EntityEditSession {
            <<AggregateRoot>>
            +string nodeId
            +AttributeField[] fields
            +string reason
            +boolean reviewing
            +datetime undoDeadline
            +openEntity()
            +changeField()
            +reviewChanges()
            +confirmSave()
            +undoSave()
            +discardChanges()
        }
    }
    class AttributeField {
        <<ValueObject>>
        +string attributeKey
        +string itemId
        +string startedWith
        +string value
        +date validFrom
        +date validTo
    }
