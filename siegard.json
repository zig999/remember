{
  "delivery_root": "siegard-delivery",
  "edits_freely": [
    "frontend"
  ],
  "specification_root": "specification",
  "standard": {
    "backend": "standards/backend-node-service.yaml",
    "database": "standards/database-migrations.yaml"
  },
  "targets": {
    "backend": "backend",
    "database": "migrations",
    "frontend": "frontend"
  },
  "telemetry_root": "siegard-telemetry",
  "tests": {
    "backend": [
      {
        "nested": true,
        "suffix": ".spec.ts",
        "under": "src"
      },
      {
        "nested": true,
        "suffix": ".test.ts",
        "under": "src"
      }
    ],
    "frontend": [
      {
        "under": "src",
        "suffix": ".spec.ts",
        "nested": true
      },
      {
        "under": "src",
        "suffix": ".spec.tsx",
        "nested": true
      },
      {
        "under": "src",
        "suffix": ".test.ts",
        "nested": true
      },
      {
        "under": "src",
        "suffix": ".stories.tsx",
        "nested": true
      },
      {
        "under": "e2e",
        "suffix": ".spec.ts",
        "nested": true
      },
      {
        "under": "src/features/curation/api/__tests__",
        "suffix": "handlers.ts",
        "nested": false
      }
    ]
  },
  "work_root": "siegard-work"
}
